{
  "name": "slack-status-sync",
  "version": "1.1.0",
  "description": "Sync Slack status and DND from local Calendar.app event titles",
  "type": "module",
  "bin": {
    "slack-status-sync": "./dist/cli.js"
  },
  "scripts": {
    "build:native": "bash scripts/build-native.sh",
    "build:ts": "tsc",
    "build": "npm run build:native && npm run build:ts",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "calendar:authorize": "tsx src/cli.ts calendar authorize",
    "calendar:status": "tsx src/cli.ts calendar status",
    "calendar:list": "tsx src/cli.ts calendar list",
    "auth:slack": "tsx src/cli.ts auth slack",
    "sync": "tsx src/cli.ts sync --once",
    "run": "tsx src/cli.ts run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "license": "MIT",
  "dependencies": {
    "@slack/web-api": "^7.8.0",
    "commander": "^13.1.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
